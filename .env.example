# ==============================================================================
# SUBliGESTÃO ERP - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (HOSTINGER / VPS / DOCKER)
# ==============================================================================

# Ambiente de execução (production ou development)
NODE_ENV="production"

# Porta do servidor Express/Node.js (A Hostinger/PM2 injeta automaticamente se configurado)
PORT=3000

# URL do sistema para links de callback e rotas absolutas
APP_URL="https://seu-dominio.com.br"

# ------------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL / Supabase / Hostinger PostgreSQL)
# ------------------------------------------------------------------------------
# String de conexão PostgreSQL no formato: postgresql://usuario:senha@host:porta/bancodedados
# Exemplo Supabase: postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/subligestao"

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO JWT
# ------------------------------------------------------------------------------
# Altere estes segredos para frases longas e aleatórias em produção
JWT_SECRET="subligestao-enterprise-jwt-super-secret-key-production-2026"
JWT_REFRESH_SECRET="subligestao-refresh-secret-key-production-2026"

# ------------------------------------------------------------------------------
# INTEGRAÇÃO COM GOOGLE GEMINI AI
# ------------------------------------------------------------------------------
# Chave da API Google Gemini para assistentes de inteligência no ERP
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"

# ------------------------------------------------------------------------------
# SERVIÇOS FISCAIS DE EMISSÃO DE NFe / NFSe (OPCIONAL)
# ------------------------------------------------------------------------------
# Integrador Spedy NFe
SPEDY_API_KEY="SUA_CHAVE_SPEDY_API_AQUI"

# Integrador Focus NFe
FOCUS_NFE_TOKEN="SEU_TOKEN_FOCUS_NFE_AQUI"
